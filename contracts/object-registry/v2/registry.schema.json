{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/contracts/object-registry/v2/registry.schema.json",
  "title": "Nex canonical object type registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "schema_version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "registry_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaration" }
    }
  },
  "$defs": {
    "relationshipSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "cardinality", "target_object_type_ids"],
      "properties": {
        "relationship_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "cardinality": {
          "enum": ["optional_one", "required_one", "optional_many", "required_many"]
        },
        "target_object_type_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type_id",
        "names",
        "owner_domain",
        "identity_contract_id",
        "identity_schema",
        "attributes_schema",
        "relationship_slots",
        "accepted_input_terms",
        "search_terms",
        "resolution_binding"
      ],
      "properties": {
        "object_type_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["singular", "plural"],
          "properties": {
            "singular": { "type": "string", "minLength": 1 },
            "plural": { "type": "string", "minLength": 1 }
          }
        },
        "owner_domain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "identity_contract_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "identity_schema": {
          "type": "object",
          "required": ["type", "additionalProperties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          }
        },
        "attributes_schema": {
          "type": "object",
          "required": ["type", "additionalProperties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          }
        },
        "relationship_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipSlot" }
        },
        "accepted_input_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "search_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resolution_binding": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      }
    }
  }
}
