{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex.local/contracts/object-registry/v1/registry.schema.json",
  "title": "Nex and MoonSleep object registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "schema_version",
    "status",
    "scope",
    "decision_contract",
    "repositories",
    "entries",
    "open_gaps"
  ],
  "properties": {
    "registry_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["proposed_canonical", "canonical", "retired"] },
    "scope": { "type": "string", "minLength": 1 },
    "decision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookup_order", "allowed_decisions", "new_object_requirements"],
      "properties": {
        "lookup_order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "allowed_decisions": {
          "type": "array",
          "const": ["reuse", "generalize", "create"]
        },
        "new_object_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "role"],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "role": { "type": "string", "minLength": 1 },
          "workspace_hint": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "open_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "title", "status", "owner", "decision"],
        "properties": {
          "gap_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "in_progress", "resolved", "withheld"] },
          "owner": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "affected_object_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourcePointer" } }
        }
      }
    }
  },
  "$defs": {
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "path"],
      "properties": {
        "repository_id": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "storagePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "surface", "status"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "identity_field": { "type": "string" },
        "status": { "enum": ["canonical", "projection", "reference", "compatibility", "legacy"] },
        "note": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "target_object_id", "cardinality", "owner"],
      "properties": {
        "relationship_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "target_object_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "cardinality": { "enum": ["one", "optional_one", "many", "optional_many"] },
        "owner": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "display_name",
        "registry_class",
        "domain",
        "lifecycle_status",
        "canonical_owner",
        "definition",
        "stable_identity",
        "canonical_storage",
        "key_fields",
        "relationships",
        "observation_target",
        "projection_authority",
        "action_authority",
        "source_contracts",
        "legacy_aliases",
        "forbidden_parallel_objects",
        "open_questions"
      ],
      "properties": {
        "object_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "registry_class": {
          "enum": [
            "nex_primitive",
            "business_resource",
            "typed_supporting_object",
            "evidence_custody",
            "read_model",
            "workflow_candidate",
            "compatibility_alias"
          ]
        },
        "domain": { "type": "string", "minLength": 1 },
        "lifecycle_status": { "enum": ["planned", "implemented", "deployed", "compatibility", "legacy", "retired"] },
        "canonical_owner": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "stable_identity": { "type": "string", "minLength": 1 },
        "revision_identity": { "type": "string" },
        "canonical_storage": { "type": "array", "items": { "$ref": "#/$defs/storagePointer" } },
        "read_surfaces": { "type": "array", "items": { "type": "string" } },
        "key_fields": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "evidence_inputs": { "type": "array", "items": { "type": "string" } },
        "observation_target": { "enum": ["direct", "through_owner_adapter", "not_applicable", "compatibility_only"] },
        "observation_head_rule": { "type": "string" },
        "projection_authority": { "type": "boolean" },
        "action_authority": { "type": "boolean" },
        "source_contracts": { "type": "array", "items": { "$ref": "#/$defs/sourcePointer" } },
        "deployed_release_receipts": { "type": "array", "items": { "type": "string" } },
        "target_adapter_contracts": { "type": "array", "items": { "type": "string" } },
        "legacy_aliases": { "type": "array", "items": { "type": "string" } },
        "forbidden_parallel_objects": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
