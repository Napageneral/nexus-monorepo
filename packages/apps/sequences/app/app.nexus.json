{
  "id": "sequences",
  "version": "0.1.0",
  "displayName": "Sequences",
  "description": "Run approved, time-anchored email and giveaway sequences on the Nex Jobs kernel. P1b: import, observe, replay and shadow, read-only toward the world.",
  "skill": "./SKILL.md",
  "handler": "./methods/index.ts",
  "hosting": {
    "required_server_class": "standard",
    "deployment_class": "customer_server"
  },
  "storage": {
    "postgres": {
      "schema": "sequences",
      "migrations": "./storage/migrations"
    }
  },
  "hooks": {
    "onInstall": "./hooks/install.ts",
    "onActivate": "./hooks/activate.ts",
    "onDeactivate": "./hooks/deactivate.ts",
    "onUpgrade": "./hooks/upgrade.ts",
    "onUninstall": "./hooks/uninstall.ts"
  },
  "methods": {
    "sequences.health": {
      "description": "Engine heartbeat and counts for the off-host dead-man: tick age, series, overdue, held, quarantined, open alerts, next due time and the alert delivery rounds (ids and counts only).",
      "action": "read",
      "access": "authenticated",
      "connection_required": false,
      "mutates_remote": false,
      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    },
    "sequences.runtime.configure": {
      "description": "Plan, then apply with the exact plan sha and the literal confirmation, the six job definitions and the one tick schedule; the only method that arms or parks the tick.",
      "action": "write",
      "access": "admin",
      "connection_required": false,
      "mutates_remote": false,
      "params": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "plan",
              "apply"
            ]
          },
          "target": {
            "enum": [
              "armed",
              "parked"
            ]
          },
          "expected_plan_sha256": {
            "type": "string",
            "description": "From the plan.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "confirmation": {
            "const": "CONFIGURE_SEQUENCES_RUNTIME"
          },
          "by": {
            "type": "string",
            "description": "Who acts: claude@tyler-mac#<session>, luna@team1 (no dots, never an address).",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,40}@[a-z0-9][a-z0-9_-]{0,40}(#[A-Za-z0-9_-]{1,40})?$"
          }
        },
        "additionalProperties": false,
        "required": [
          "mode"
        ]
      },
      "response": {
        "type": "object",
        "description": "sequences_output_v1 (schema/output-v1.json)"
      }
    },
    "sequences.definitions.register": {
      "description": "Compile a sequence definition (PyYAML-normalized JSON) and, with mode apply, store it as an immutable revision.",
      "action": "write",
      "access": "authenticated",
      "connection_required": false,
      "mutates_remote": false,
      "params": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object"
          },
          "yaml_sha256": {
            "type": "string",
            "description": "sha256 of the YAML bytes.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_commit": {
            "type": "string",
            "description": "moonsleep-v1 commit.",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "mode": {
            "enum": [
              "check",
              "apply"
            ]
          },
          "by": {
            "type": "string",
            "description": "Who acts: claude@tyler-mac#<session>, luna@team1 (no dots, never an address).",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,40}@[a-z0-9][a-z0-9_-]{0,40}(#[A-Za-z0-9_-]{1,40})?$"
          }
        },
        "additionalProperties": false,
        "required": [
          "definition",
          "yaml_sha256",
          "source_commit"
        ]
      },
      "response": {
        "type": "object",
        "description": "sequences_output_v1 (schema/output-v1.json)"
      }
    },
    "sequences.definitions.get": {
      "description": "Read a registered definition and its revisions.",
      "action": "read",
      "access": "authenticated",
      "connection_required": false,
      "mutates_remote": false,
      "params": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Sequence name."
          },
          "revision": {
            "type": [
              "integer",
              "string"
            ]
          },
          "by": {
            "type": "string",
            "description": "Who acts: claude@tyler-mac#<session>, luna@team1 (no dots, never an address).",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,40}@[a-z0-9][a-z0-9_-]{0,40}(#[A-Za-z0-9_-]{1,40})?$"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "response": {
        "type": "object",
        "description": "sequences_output_v1 (schema/output-v1.json)"
      }
    },
    "sequences.series.import": {
      "description": "Validate an October import bundle (V1-V10) as a preview with a pt_ token, then apply it idempotently by bundle sha: definitions, the observing series, adopted drawings, the ledger and campaign_only send decisions.",
      "action": "write",
      "access": "authenticated",
      "connection_required": false,
      "mutates_remote": false,
      "params": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "object",
            "description": "schema/import-bundle-v1.json"
          },
          "mode": {
            "enum": [
              "preview",
              "apply"
            ]
          },
          "preview_token": {
            "type": "string",
            "description": "From the preview.",
            "pattern": "^pt_[0-9a-f]{32}$"
          },
          "by": {
            "type": "string",
            "description": "Who acts: claude@tyler-mac#<session>, luna@team1 (no dots, never an address).",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,40}@[a-z0-9][a-z0-9_-]{0,40}(#[A-Za-z0-9_-]{1,40})?$"
          }
        },
        "additionalProperties": false,
        "required": [
          "bundle"
        ]
      },
      "response": {
        "type": "object",
        "description": "sequences_output_v1 (schema/output-v1.json)"
      }
    },
    "sequences.brief.get": {
      "description": "How it's going: the two-clause verdict, what finished since the window opened, what is short, what is ahead, and what Tyler already heard.",
