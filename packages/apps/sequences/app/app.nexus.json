            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          },
          "s": {
            "type": "string",
            "description": "Series slug, e.g. review-giveaway-2026-10.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          },
          "since": {
            "type": "string",
