{
  "name": "moonsleep-partner-desk-app",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ui/vite.config.ts",
    "build:production-release": "node scripts/build-production-release.mjs",
    "prepare:canonical-migration": "node --experimental-strip-types scripts/prepare-canonical-migration.mjs",
    "test": "node --test --experimental-strip-types src/*.test.ts && vitest run methods/*.test.ts hooks/*.test.ts ui/src/*.test.ts",
    "test:canonical-prep": "./scripts/test-canonical-prep-cleanroom.sh",
    "test:semantic-calibration": "vitest run src/semantic-calibration.spec.ts",
    "verify:production-postflight": "node scripts/verify-dormant-upgrade-postflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tar": "7.5.22",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "^3.2.7"
  }
}
