{
  "id": "moonsleep-partner-desk",
  "version": "0.3.0",
  "displayName": "MoonSleep Partner Desk",
  "description": "Track reviewed supplier and partner open loops over immutable provider-native communications.",
  "skill": "./SKILL.md",
  "handler": "./methods/index.ts",
  "ui": {
    "root": "./ui/dist",
    "entryPath": "/app/moonsleep-partner-desk/",
    "spa": true
  },
  "hooks": {
    "onInstall": "./hooks/install.ts",
    "onActivate": "./hooks/activate.ts",
    "onDeactivate": "./hooks/deactivate.ts",
    "onUpgrade": "./hooks/upgrade.ts",
    "onUninstall": "./hooks/uninstall.ts"
  },
  "hosting": {
    "required_server_class": "standard",
    "deployment_class": "customer_server"
  },
  "product": {
    "tagline": "Every supplier question tracked to evidence-backed closure",
    "accentColor": "#8a5a31",
    "visibility": "customer",
    "plans": [
      {
        "id": "moonsleep-partner-desk-internal",
        "displayName": "MoonSleep Partner Desk Internal",
        "priceMonthly": 0,
        "isDefault": true
      }
    ]
  },
  "methods": {
    "moonsleep-partner-desk.healthcheck": {
      "description": "Report the installed Partner Desk projection and dormant work contract.",
      "action": "read",
      "access": "authenticated",
      "params": {"type": "object", "properties": {}, "additionalProperties": false},
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.alibaba.inspect-conversation": {
      "description": "Inspect and hash one complete committed Alibaba native conversation without returning message content.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "provider_thread_id": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "required": ["connection_id", "provider_thread_id"],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.gmail.inspect-conversation": {
      "description": "Inspect and hash one complete committed Gmail native conversation without returning message content.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "provider_thread_id": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "required": ["connection_id", "provider_thread_id"],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.project-reviewed-cohort": {
      "description": "Project a bounded reviewed cohort into native threads, independent open loops, and attention queues.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "identity_resolutions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
          "workspace_assertions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
          "open_loop_assertions": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
          "source_coverage_assertions": {"type": "array", "maxItems": 50, "items": {"type": "object"}}
        },
        "required": [
          "record_ids",
          "identity_resolutions",
          "workspace_assertions",
          "open_loop_assertions",
          "source_coverage_assertions"
        ],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.source.inbox": {
      "description": "List one bounded page of committed partner communication records with reviewed and proposal coverage state.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "provider": {"type": "string", "enum": ["alibaba", "gmail"]},
          "connection_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "provider_thread_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "coverage_state": {
            "type": "string",
            "enum": ["unreviewed", "proposed", "proposal_conflict", "reviewed"]
          },
          "offset": {"type": "integer", "minimum": 0, "maximum": 99999},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        },
        "required": ["provider"],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.proposal.list": {
      "description": "List immutable Partner Desk proposal batches without promoting them into reviewed operational state.",
      "action": "read",
      "access": "authenticated",
      "params": {"type": "object", "properties": {}, "additionalProperties": false},
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.proposal.commit": {
      "description": "Commit one replay-safe immutable coverage and open-loop proposal batch bound to exact source revisions.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "workspace_key": {"type": "string", "minLength": 1, "maxLength": 128},
          "proposed_canonical_entity_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "proposed_contact_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "partner_category": {
            "type": "string",
            "enum": [
              "vendor",
              "fulfillment_partner",
              "logistics_partner",
              "packaging_partner",
              "marketplace_partner",
              "professional_service",
              "creator_partner"
            ]
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "open_loop_proposals": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "object"}
          },
          "source_coverage_proposals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {"type": "object"}
          },
          "classifier_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "classifier_prompt_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
          "proposal_note": {"type": "string", "minLength": 1, "maxLength": 2048},
          "proposal_idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}
        },
        "required": [
          "workspace_key",
          "proposed_canonical_entity_id",
          "partner_category",
          "record_ids",
          "open_loop_proposals",
          "source_coverage_proposals",
          "classifier_id",
          "classifier_prompt_sha256",
          "proposal_idempotency_key"
        ],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.review.current": {
      "description": "Read the unique current immutable review head for one Partner Desk workspace.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "workspace_key": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["workspace_key"],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.review.workspaces": {
      "description": "List the immutable current review heads available to the Partner Desk UI.",
      "action": "read",
      "access": "authenticated",
      "params": {"type": "object", "properties": {}, "additionalProperties": false},
      "response": {"type": "object"}
    },
    "moonsleep-partner-desk.review.commit": {
      "description": "Commit one replay-safe immutable operator review revision through canonical Nex record ingress.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "workspace_key": {"type": "string", "minLength": 1, "maxLength": 128},
          "canonical_entity_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "identity_resolutions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
          "workspace_assertions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
          "open_loop_assertions": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
          "source_coverage_assertions": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
          "review_note": {"type": "string", "minLength": 1, "maxLength": 2048},
          "review_idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
          "previous_revision_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64}
        },
        "required": [
          "workspace_key",
          "canonical_entity_id",
          "record_ids",
          "identity_resolutions",
          "workspace_assertions",
          "open_loop_assertions",
          "source_coverage_assertions",
          "review_idempotency_key",
          "previous_revision_sha256"
        ],
        "additionalProperties": false
      },
      "response": {"type": "object"}
    }
  }
}
