{
  "id": "moonsleep-commerce",
  "version": "0.3.28",
  "displayName": "MoonSleep Commerce",
  "description": "Project exact Shopify records into MoonSleep identity and typed commerce state through public Nex operations.",
  "skill": "./SKILL.md",
  "handler": "./methods/index.ts",
  "hooks": {
    "onInstall": "./hooks/install.ts",
    "onActivate": "./hooks/activate.ts",
    "onDeactivate": "./hooks/deactivate.ts",
    "onUpgrade": "./hooks/upgrade.ts",
    "onUninstall": "./hooks/uninstall.ts"
  },
  "hosting": {
    "required_server_class": "standard",
    "deployment_class": "customer_server"
  },
  "product": {
    "tagline": "Exact provider evidence into durable customer and commerce state",
    "accentColor": "#0f766e",
    "visibility": "customer",
    "plans": [
      {
        "id": "moonsleep-commerce-internal",
        "displayName": "MoonSleep Commerce Internal",
        "priceMonthly": 0,
        "isDefault": true
      }
    ]
  },
  "methods": {
    "moonsleep-commerce.healthcheck": {
      "description": "Report the installed MoonSleep commerce projector contract.",
      "action": "read",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {}
      },
      "response": {
        "type": "object"
      }
    },
    "moonsleep-commerce.shopify-source.seed-identities": {
      "description": "Replay-safely seed distinct Shopify store and integration identities and ground the local receiver to MoonSleep Ops through public Nex identity operations.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "shop_domain": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.myshopify\\.com$",
            "maxLength": 255
          },
          "connection_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
            "maxLength": 128
          }
        },
        "required": ["shop_domain", "connection_id"],
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    },
    "moonsleep-commerce.shopify-source.trigger": {
      "description": "Queue one exact Shopify source family or verified immutable Shopify observation through its durable Nex job without enabling the recurring schedule.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "orders.delta",
              "customers.delta",
              "inventory.hot",
              "inventory.reconcile",
              "fulfillment.delta",
              "discounts.delta",
              "finance.transactions",
              "disputes.delta",
              "products.delta",
              "catalog.delta",
              "marketing.delta",
              "payouts.delta"
            ]
          },
          "connection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._:-]+$"
          },
          "observation": {
            "type": "object",
            "properties": {
              "projection_work_id": {
                "type": "string",
                "pattern": "^channelprojection_[0-9a-f]{32}$"
              },
              "observation_receipt_id": {
                "type": "string",
                "pattern": "^channelobs_[0-9a-f]{32}$"
              },
              "projection_target": {
                "type": "string",
                "enum": ["nex"]
              },
              "source_system": {
                "type": "string",
                "enum": ["shopify"]
              },
              "source_account_ref": {
                "type": "string",
                "enum": ["moonsleep"]
              },
              "source_stream": {
                "type": "string",
                "enum": [
                  "orders/paid",
                  "orders/updated",
                  "orders/cancelled",
                  "customers/created",
                  "customers/updated"
                ]
              },
              "external_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "semantic_revision_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "raw_body_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "verification_issuer": {
                "type": "string",
                "enum": ["shopify-hmac-sha256"]
              },
              "verification_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "immutable_facts_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "immutable_facts": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": [
              "projection_work_id",
              "observation_receipt_id",
              "projection_target",
              "source_system",
              "source_account_ref",
              "source_stream",
              "external_receipt_id",
              "semantic_revision_id",
              "raw_body_sha256",
              "verification_issuer",
              "verification_receipt_sha256",
              "observation_sha256",
              "immutable_facts_sha256",
              "immutable_facts"
            ],
            "additionalProperties": false
          }
        },
        "required": ["family", "connection_id"],
        "anyOf": [
          { "required": ["request_id"] },
          { "required": ["observation"] }
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    },
    "moonsleep-commerce.shopify-source.configure-schedules": {
      "description": "Plan or apply the exact connection binding and independently enabled Shopify source schedules without making a Shopify provider request.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["plan", "apply"]
          },
          "connection_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
            "maxLength": 128
          },
          "enabled_families": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": {
              "type": "string",
              "enum": [
                "orders.delta",
                "customers.delta",
                "inventory.hot",
                "inventory.reconcile",
                "fulfillment.delta",
                "discounts.delta",
                "finance.transactions",
                "disputes.delta",
                "products.delta",
                "catalog.delta",
                "marketing.delta",
                "payouts.delta"
              ]
            }
          },
          "expected_plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "confirmation": {
            "type": "string",
            "enum": ["CONFIGURE_MOONSLEEP_SHOPIFY_SOURCE_SCHEDULES"]
          }
        },
        "required": ["mode", "connection_id", "enabled_families"],
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    },
    "moonsleep-commerce.shopify-projections.configure": {
      "description": "Plan or apply the exact durable record.ingested customer and commerce projections without Shopify provider access.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["plan", "apply"]
          },
          "enabled_projections": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": ["customer_identity", "order_commerce"]
            }
          },
          "expected_plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "confirmation": {
            "type": "string",
            "enum": ["CONFIGURE_MOONSLEEP_SHOPIFY_PROJECTIONS"]
          }
        },
        "required": ["mode", "enabled_projections"],
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    },
    "moonsleep-commerce.shopify-customers.project-cohort": {
      "description": "Project an explicit bounded cohort of immutable Shopify customer Records into Nex identity, accepted customer-role evidence, and the canonical Customer Facet using replay-safe public operations.",
      "action": "write",
      "access": "authenticated",
      "params": {
        "type": "object",
        "properties": {
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "required": ["record_ids"],
        "additionalProperties": false
      },
      "response": {
        "type": "object"
      }
    }
  }
}
